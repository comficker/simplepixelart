# All variables are optional — the defaults point at the hosted API and site.

# Backend API base URL (hosted service; not part of this repo)
NUXT_PUBLIC_API=https://touch.ninosaur.com

# Canonical site URL (used for SEO tags and sitemaps)
NUXT_PUBLIC_SITE_URL=https://simplepixelart.com

# Set to "false" to disable AdSense/analytics scripts entirely (e.g. local dev)
NUXT_PUBLIC_ADS_ENABLED=false
